{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc", ".yarnrc.yml"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build:android": {
      "env": ["ANDROID_HOME", "ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/android/**",
        "!$TURBO_ROOT$/android/**/build/**",
        "!$TURBO_ROOT$/android/**/generated/**",
        "!$TURBO_ROOT$/android/**/.gradle/**",
        "!$TURBO_ROOT$/android/**/.cxx/**",
        "!android/**/build/**",
        "!android/**/generated/**",
        "!android/**/.gradle/**",
        "!android/**/.cxx/**",
        "!ios/**",
        "!vendor/**"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": [
        "RCT_NEW_ARCH_ENABLED",
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/*.podspec",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/ios/**",
        "!$TURBO_ROOT$/ios/**/build/**",
        "!$TURBO_ROOT$/ios/**/generated/**",
        "!$TURBO_ROOT$/ios/**/Pods/**",
        "!$TURBO_ROOT$/ios/**/DerivedData/**",
        "!ios/**/build/**",
        "!ios/**/generated/**",
        "!ios/**/Pods/**",
        "!ios/**/DerivedData/**",
        "!android/**",
        "!vendor/**"
      ],
      "outputs": []
    }
  }
}
